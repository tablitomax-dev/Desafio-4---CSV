# Copie para .env e preencha os valores. NUNCA commite este arquivo.
OPENROUTER_API_KEY=sk-EXEMPLO-NAO-E-REAL

# Modelo primario + provider (validado no spike)
MODEL=deepseek/deepseek-v4-flash-0731:deepinfra/fp4
PROVIDER=deepinfra/fp4

# Modelo fallback: usado se o primario esgotar retries de tool
FALLBACK_MODEL=openai/gpt-5.6-luna-pro
FALLBACK_PROVIDER=openai
